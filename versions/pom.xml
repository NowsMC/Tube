<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.nows</groupId>
    <artifactId>tube-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>tube-versions</artifactId>
  <packaging>pom</packaging>
  <name>Tube Versions</name>
  <description>One module and one server jar per supported Minecraft version</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <tube.server.release.files>none</tube.server.release.files>
    <tube.server.release.upload>none</tube.server.release.upload>
    <tube.server.jar>${project.build.finalName}.jar</tube.server.jar>
    <tube.server.release>${project.build.directory}/release</tube.server.release>
    <tube.server.release.key>${tube.b2.releases}/${project.version}/${tube.minecraft.version}</tube.server.release.key>
  </properties>

  <!-- A Minecraft version is turned on by listing its module here and in tube.minecraft.versions in the root pom. -->
  <modules>
    <module>26.2</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-dependency-plugin</artifactId>
          <executions>
            <execution>
              <id>list-libraries</id>
              <phase>process-classes</phase>
              <goals>
                <goal>list</goal>
              </goals>
              <configuration>
                <includeScope>runtime</includeScope>
                <excludeGroupIds>space.nows</excludeGroupIds>
                <outputFile>${project.build.outputDirectory}/META-INF/tube/libraries.txt</outputFile>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-shade-plugin</artifactId>
          <executions>
            <execution>
              <phase>package</phase>
              <goals>
                <goal>shade</goal>
              </goals>
              <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <artifactSet>
                  <includes>
                    <include>space.nows:*</include>
                  </includes>
                </artifactSet>
                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>space.nows.tube.bootstrap.Bootstrap</mainClass>
                  </transformer>
                </transformers>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>server-release-files</id>
                <phase>${tube.server.release.files}</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${tube.server.release}</outputDirectory>
                  <useDefaultDelimiters>false</useDefaultDelimiters>
                  <delimiters>
                    <delimiter>@{*}</delimiter>
                  </delimiters>
                  <resources>
                    <resource>
                      <directory>${project.parent.basedir}/src/release</directory>
                      <filtering>true</filtering>
                    </resource>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes>
                        <include>${tube.server.jar}</include>
                      </includes>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>net.nicoulaj.maven.plugins</groupId>
            <artifactId>checksum-maven-plugin</artifactId>
            <version>${checksum-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>server-release-checksums</id>
                <phase>${tube.server.release.files}</phase>
                <goals>
                  <goal>files</goal>
                </goals>
                <configuration>
                  <algorithms>
                    <algorithm>SHA-256</algorithm>
                  </algorithms>
                  <fileSets>
                    <fileSet>
                      <directory>${tube.server.release}</directory>
                      <excludes>
                        <exclude>SHA256SUMS</exclude>
                      </excludes>
                    </fileSet>
                  </fileSets>
                  <individualFiles>false</individualFiles>
                  <shasumSummary>true</shasumSummary>
                  <shasumSummaryFile>release/SHA256SUMS</shasumSummaryFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>${maven-antrun-plugin.version}</version>
            <executions>
              <execution>
                <id>server-release-checksums-lf</id>
                <phase>${tube.server.release.files}</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <fixcrlf file="${tube.server.release}/SHA256SUMS" eol="lf"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.gkatzioura.maven.cloud</groupId>
            <artifactId>s3-storage-wagon</artifactId>
            <version>${s3-storage-wagon.version}</version>
            <configuration>
              <bucket>${tube.b2.bucket}</bucket>
              <region>${tube.b2.region}</region>
            </configuration>
            <executions>
              <execution>
                <id>server-release-upload-jar</id>
                <phase>${tube.server.release.upload}</phase>
                <goals>
                  <goal>s3-upload</goal>
                </goals>
                <configuration>
                  <path>${tube.server.release}/${tube.server.jar}</path>
                  <key>${tube.server.release.key}/${tube.server.jar}</key>
                </configuration>
              </execution>
              <execution>
                <id>server-release-upload-start-sh</id>
                <phase>${tube.server.release.upload}</phase>
                <goals>
                  <goal>s3-upload</goal>
                </goals>
                <configuration>
                  <path>${tube.server.release}/start.sh</path>
                  <key>${tube.server.release.key}/start.sh</key>
                </configuration>
              </execution>
              <execution>
                <id>server-release-upload-start-bat</id>
                <phase>${tube.server.release.upload}</phase>
                <goals>
                  <goal>s3-upload</goal>
                </goals>
                <configuration>
                  <path>${tube.server.release}/start.bat</path>
                  <key>${tube.server.release.key}/start.bat</key>
                </configuration>
              </execution>
              <execution>
                <id>server-release-upload-checksums</id>
                <phase>${tube.server.release.upload}</phase>
                <goals>
                  <goal>s3-upload</goal>
                </goals>
                <configuration>
                  <path>${tube.server.release}/SHA256SUMS</path>
                  <key>${tube.server.release.key}/SHA256SUMS</key>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
