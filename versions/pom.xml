<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.nows</groupId>
    <artifactId>tube-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>tube-versions</artifactId>
  <packaging>pom</packaging>
  <name>Tube Versions</name>
  <description>One module and one server jar per supported Minecraft version</description>

  <modules>
    <module>26.1.2</module>
    <module>26.2</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-dependency-plugin</artifactId>
          <executions>
            <execution>
              <id>list-libraries</id>
              <phase>process-classes</phase>
              <goals>
                <goal>list</goal>
              </goals>
              <configuration>
                <includeScope>runtime</includeScope>
                <excludeGroupIds>space.nows</excludeGroupIds>
                <outputFile>${project.build.outputDirectory}/META-INF/tube/libraries.txt</outputFile>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-shade-plugin</artifactId>
          <executions>
            <execution>
              <phase>package</phase>
              <goals>
                <goal>shade</goal>
              </goals>
              <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <artifactSet>
                  <includes>
                    <include>space.nows:*</include>
                  </includes>
                </artifactSet>
                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>space.nows.tube.bootstrap.Bootstrap</mainClass>
                  </transformer>
                </transformers>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
